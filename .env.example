# Neo4j Aura connection (copy to .env and fill in; .env is git-ignored)
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Optional: namespace for your own instance IRIs (CURIE prefix "inst:")
# IOF_GDB_INSTANCE_NS=https://example.org/iof-gdb/instance/

# Optional: ontology profile, a built-in name (iof, generic) or a path to a .toml file
# IOF_GDB_PROFILE=iof

# Optional: bearer token for `iof-gdb-mcp --transport streamable-http` (Open WebUI etc.)
# IOF_GDB_MCP_TOKEN=
