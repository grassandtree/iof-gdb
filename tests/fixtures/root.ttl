@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ex:   <https://test.example/onto/> .

<https://test.example/onto/root> a owl:Ontology ;
    owl:imports <https://test.example/onto/mid> , <https://test.example/onto/remote> .

ex:A a owl:Class ; rdfs:label "A" ; rdfs:subClassOf ex:B .
